<?xml version="1.0"?>
<robot name="bracket_arm">

  <material name="silver"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="cyan">   <color rgba="0 1 1 1"/></material>
  <material name="green"> <color rgba="0 1 0 1"/></material>
  <material name="blue">  <color rgba="0 0 1 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="orange"><color rgba="1 0.5 0 1"/></material>
  <material name="white"> <color rgba="1 1 1 1"/></material>

  <!-- Feste Grundplatte -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.5 0.5 0.005"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="0.15 0.15 0.005"/></geometry>
    </collision>
  </link>

  <!-- Servo 0: dreht den ganzen Arm um die vertikale Achse -->
  <joint name="joint_0" type="revolute">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- Drehbarer Sockel (82mm hoch) bis zum Schulter-Servo -->
  <link name="turret_link">
    <visual>
      <geometry><cylinder length="0.082" radius="0.056"/></geometry>
      <origin xyz="0 0 0.041"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.082" radius="0.056"/></geometry>
      <origin xyz="0 0 0.041"/>
    </collision>
  </link>

  <!-- Servo 1: Schulter - dreht den Oberarm -->
  <joint name="joint_1" type="revolute">
    <parent link="turret_link"/>
    <child link="upper_arm_link"/>
    <!-- 0° = horizontal, daher -90° Offset. Schulter 8mm links versetzt. -->
    <origin xyz="-0.008 0 0.082" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- Oberarm: 98mm, Schulter bis Ellenbogen -->
  <link name="upper_arm_link">
    <visual>
      <geometry><box size="0.02 0.04 0.098"/></geometry>
      <origin xyz="0 0 0.049"/>
      <material name="cyan"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.04 0.098"/></geometry>
      <origin xyz="0 0 0.049"/>
    </collision>
  </link>

  <!-- Servo 2: Ellenbogen - dreht den Unterarm (umgekehrt eingebaut) -->
  <joint name="joint_2" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.098" rpy="0 1.5708 0"/>
    <!-- Drehrichtung. Umgekehrt eingebaut, daher -1. -->
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- Unterarm: 65mm, Ellenbogen bis Handgelenk -->
  <link name="forearm_link">
    <visual>
      <geometry><box size="0.02 0.04 0.065"/></geometry>
      <origin xyz="0 0 0.0325"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.04 0.065"/></geometry>
      <origin xyz="0 0 0.0325"/>
    </collision>
  </link>

  <!-- Servo 3: Handgelenk-Neigung -->
  <joint name="joint_3" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.065" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- Handgelenk: 70mm -->
  <link name="wrist_link">
    <visual>
      <geometry><box size="0.04 0.02 0.070"/></geometry>
      <origin xyz="0 0 0.035"/>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.02 0.070"/></geometry>
      <origin xyz="0 0 0.035"/>
    </collision>
  </link>

  <!-- Servo 4: Handgelenk-Rotation (dreht um Längsachse), am Ende von wrist_link (70mm) -->
  <joint name="joint_4" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.070" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- TCP: Werkzeugmittelpunkt (Anfasser für RViz/MoveIt), nach joint_4 damit Wrist-Rotation Teil der IK ist -->
  <joint name="joint_tcp" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tcp_link"/>

  <!-- Grasp-Punkt: Mittelpunkt zwischen den vorderen Fingern (Greifreferenz für IK/Perception) -->
  <joint name="joint_grasp" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="grasp_link"/>
    <origin xyz="0 0.01 0.10" rpy="0 0 0"/>
  </joint>

  <link name="grasp_link"/>

  <!-- ============================================================
       Calibration markers (ba_autocalib).
       Offsets are PLACEHOLDER — remeasure with caliper before use.
       Coordinate frames = URDF parent-link frame (see ba_autocalib README).
       ============================================================ -->
  <!-- Red ball on the gripper housing (primary data point).
       Measured to ball centre with caliper:
         5 cm along gripper axis (z) from joint_4 rotation point,
         3 cm outward from axis (y). Ball radius 9 mm. -->
  <joint name="joint_marker_grasp" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="marker_grasp"/>
    <origin xyz="0 0.034 0.05" rpy="0 0 0"/>
  </joint>
  <link name="marker_grasp">
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>

  <!-- Yellow ball on the wrist.
       Physically attached to wrist_link (not forearm_link).
       Measured from joint_3 (wrist_link origin) with caliper:
         z = 4.9 cm along wrist axis from joint_3
         x = 2.2 cm outward offset (negative x direction) -->
  <joint name="joint_marker_forearm" type="fixed">
    <parent link="wrist_link"/>
    <child link="marker_forearm"/>
    <origin xyz="-0.022 0 0.049" rpy="0 0 0"/>
  </joint>
  <link name="marker_forearm">
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="marker_yellow"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>

  <!-- Blue ball on the base plate (static anchor).
       Measured to ball centre with caliper:
         6.5 cm forward, 9.8 cm left, 1.6 cm up.
       base_link frame: +X=right, +Y=forward, +Z=up.
       Therefore: forward=+Y, left=-X. -->
  <joint name="joint_marker_base" type="fixed">
    <parent link="base_link"/>
    <child link="marker_base"/>
    <origin xyz="-0.098 0.065 0.016" rpy="0 0 0"/>
  </joint>
  <link name="marker_base">
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="marker_blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>

  <!-- Greifer-Basis: 30mm -->
  <link name="gripper_base_link">
    <visual>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <origin xyz="0 0 0.015"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <origin xyz="0 0 0.015"/>
    </collision>
  </link>

  <!-- Servo 5: Greifer öffnen/schliessen -->

  <!-- Linker Finger, an der Vorderkante gripper_base (z=0.03) -->
  <joint name="joint_5" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_finger_left_link"/>
    <origin xyz="-0.01 0.01 0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
  </joint>

  <!-- Linker Finger: Greiferspitze: 70mm -->
  <link name="gripper_finger_left_link">
    <visual>
      <geometry><box size="0.02 0.01 0.07"/></geometry>
      <origin xyz="0 0 0.035"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.01 0.07"/></geometry>
      <origin xyz="0 0 0.035"/>
    </collision>
  </link>

  <!-- Rechter Finger - gespiegelt, mimic von joint_5 -->
  <joint name="joint_5_mimic" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_finger_right_link"/>
    <origin xyz="0.01 0.01 0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="3.14160" effort="10" velocity="1.0"/>
    <mimic joint="joint_5" multiplier="-1" offset="0"/>
  </joint>

  <!-- Rechter Finger: Greiferspitze: 70mm -->
  <link name="gripper_finger_right_link">
    <visual>
      <geometry><box size="0.02 0.01 0.07"/></geometry>
      <origin xyz="0 0 0.035"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.01 0.07"/></geometry>
      <origin xyz="0 0 0.035"/>
    </collision>
  </link>


  <!-- Overview camera — physically measured position 2026-04-19.
       base_link: +X=right, +Y=forward, +Z=up.
       Camera at: 17 cm forward (+Y), 16 cm left (-X), 34 cm up (+Z).
       Optical axis toward workspace: +X and -Z (right + down).
       pitch = pi - atan(17/34) = pi - atan(0.5) ≈ 2.678 rad, yaw/roll = 0.
       Named "..._nominal" to avoid TF conflict with autocalib_node,
       which publishes "overview_camera_link" after each solve. -->
  <joint name="joint_overview_camera_nominal" type="fixed">
    <parent link="base_link"/>
    <child link="overview_camera_nominal"/>
    <origin xyz="-0.16 0.17 0.34" rpy="-2.678 0 -1.5708"/>
  </joint>
  <link name="overview_camera_nominal"/>

</robot>

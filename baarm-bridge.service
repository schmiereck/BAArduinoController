[Unit]
Description=BA Arm ROS2 Bridge Service
After=network.target
StartLimitInterval=200
StartLimitBurst=5

[Service]
Type=exec
User=pi
WorkingDirectory=/home/pi/ros2_ws
Environment="ROS_DOMAIN_ID=1"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="ROS_DISTRO=humble"
# Optional: externe Env-Variablen laden (wenn nicht vorhanden, keine Fehler)
EnvironmentFile=-/home/pi/.ros2_env

# Starte die ROS2 Launch (optional: source .bashrc falls vorhanden)
ExecStart=/bin/bash -c '\
  [ -f $HOME/.bashrc ] && source $HOME/.bashrc; \
  source $HOME/ros2_ws/install/setup.bash; \
  exec ros2 launch BAArduinoController pi_bridge.launch.py'

# Auto-neustarten bei Fehler
Restart=on-failure
RestartSec=5

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baarm-bridge

[Install]
WantedBy=multi-user.target

[Unit]
Description=BA Arm ROS2 Bridge Service
After=network.target
StartLimitInterval=200
StartLimitBurst=5

[Service]
Type=exec
User=pi
WorkingDirectory=/home/pi/ros2_ws
Environment="ROS_DOMAIN_ID=1"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
EnvironmentFile=/home/pi/.ros2_env

# Starte die ROS2 Launch
# Der ExecStart nutzt die echte HOME-variable des Users (wird beim Start ersetzt)
ExecStart=/bin/bash -c 'source $HOME/.bashrc && source $HOME/ros2_ws/install/setup.bash && ros2 launch BAArduinoController pi_bridge.launch.py'

# Auto-neustarten bei Fehler
Restart=on-failure
RestartSec=5

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baarm-bridge

[Install]
WantedBy=multi-user.target
